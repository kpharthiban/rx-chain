# Get your RPC URL from Infura or Alchemy (free account)
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY_HERE

# Export your MetaMask private key (deployer wallet only — NEVER share this)
DEPLOYER_PRIVATE_KEY=YOUR_PRIVATE_KEY_HERE

# Get from https://etherscan.io/myapikey (free account)
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY_HERE

# Get from https://app.pinata.cloud/keys (free account)
PINATA_API_KEY=YOUR_PINATA_API_KEY_HERE
PINATA_SECRET_KEY=YOUR_PINATA_SECRET_KEY_HERE